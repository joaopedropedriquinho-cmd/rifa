# Copy to .env and fill only with credentials for your own local/test environment.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://rifa_app:replace_me@127.0.0.1:5432/rifa?schema=public
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:5173
RESERVATION_TTL_MINUTES=15
# Payments intentionally remain disabled until a lawful use case and provider
# approval have been verified. Never put provider secrets in the frontend.
