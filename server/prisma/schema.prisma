generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SlotStatus {
  FREE
  RESERVED
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum OperationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model User {
  id           String      @id @default(cuid())
  name         String      @db.VarChar(80)
  email        String      @unique @db.VarChar(254)
  passwordHash String      @db.VarChar(100)
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  operations   Operation[]
  auditLogs    AuditLog[]

  @@index([createdAt])
}

model NumberSlot {
  number               Int              @id
  status               SlotStatus       @default(FREE)
  operationId          String?
  reservationExpiresAt DateTime?
  operation            Operation?       @relation(fields: [operationId], references: [id], onDelete: Restrict)
  history              OperationNumber[]

  @@index([status, reservationExpiresAt])
  @@index([operationId])
}

model Operation {
  id        String           @id @default(cuid())
  userId    String
  status    OperationStatus  @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  slots     NumberSlot[]
  numbers   OperationNumber[]
  payment   Payment?
  auditLogs AuditLog[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OperationNumber {
  operationId String
  number      Int
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Restrict)
  slot        NumberSlot @relation(fields: [number], references: [number], onDelete: Restrict)

  @@id([operationId, number])
  @@index([number])
}

model Payment {
  id                String        @id @default(cuid())
  operationId       String        @unique
  provider          String?
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("BRL") @db.Char(3)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  operation         Operation     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  webhookEvents     WebhookEvent[]
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  paymentId   String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  outcome     String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([receivedAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  userId      String?
  operationId String?
  action      String     @db.VarChar(80)
  outcome     String     @db.VarChar(40)
  details     Json?
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([operationId])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
